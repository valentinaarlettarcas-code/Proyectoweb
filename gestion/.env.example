# Plantilla de variables de entorno del servicio Gestión.
# Django no lee este archivo: define las variables en la terminal o en el despliegue.
# No escribas valores reales aquí.

# Obligatorias
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DB_PASSWORD=cambia-esto

# Opcionales (estos son los valores por defecto)
DB_NAME=gestion_db
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
DJANGO_DEBUG=True
