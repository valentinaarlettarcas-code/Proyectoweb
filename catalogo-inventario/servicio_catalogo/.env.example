# Copiar este archivo como .env; settings.py de main lo carga automaticamente.
# Usar secretos diferentes por entorno; no publicar valores reales.
DJANGO_SECRET_KEY=replace-with-strong-local-django-secret
GESTION_VERIFY_TOKEN_URL=http://127.0.0.1:8001/api/usuarios/verificar-token/
CATALOGO_INTERNAL_TOKEN=replace-with-strong-shared-secret-for-commerce
# MongoDB con replica set configurado si se usan transacciones de reservas/RF19.
# Sustituir host, puerto y replicaSet por los del entorno real.
CATALOGO_MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs_catalogo&directConnection=true
